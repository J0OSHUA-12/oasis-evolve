<?xml version="1.0" encoding="utf-8"?>
<!-- Solo en la versión de depuración: ganchos para probar desde adb. Nunca va en la versión diaria. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <!-- DUMP solo lo tiene el shell de adb: ninguna app instalada puede llamar a este receptor. -->
        <receiver
            android:name=".DebugHooks"
            android:exported="true"
            android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="com.oasisevolve.launcher.debug.QUIET_PACKAGE" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
