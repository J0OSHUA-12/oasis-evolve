<?xml version="1.0" encoding="utf-8"?>
<!--
    Lo mínimo para el bloqueo: solo cambios de ventana, sin leer el contenido de la pantalla.
    La lista de apps se fija desde el servicio con las que el usuario vigila; aquí empieza vacía
    (solo el propio launcher), para no recibir avisos de ninguna otra app antes de saberlas.
-->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowStateChanged"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:canRetrieveWindowContent="false"
    android:description="@string/guard_description"
    android:isAccessibilityTool="false"
    android:notificationTimeout="200"
    android:packageNames="com.oasisevolve.launcher" />
